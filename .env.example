# Documentation only; never loaded implicitly. No completed copy in the checkout.
# Set roots in the process environment; CARTE_* is forbidden INSIDE the private secret file.
CARTE_PUBLIC_DIR=/srv/cartehesta/public
CARTE_DATA_DIR=/srv/cartehesta/data
CARTE_MEDIA_DIR=/srv/cartehesta/media-private
CARTE_LOG_DIR=/var/log/cartehesta
CARTE_ENV_FILE=/etc/cartehesta/cartehesta.env
NODE_ENV=production
HOST=127.0.0.1
PORT=4173
COOKIE_SECURE=true
SESSION_SECRET=
SESSION_TTL_MS=2592000000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://cartehesta.dannytech.fr/auth/discord/callback
# Persisted roles only; no automatic Discord administrator promotion.
ADMIN_API_TOKEN=
USER_API_TOKENS=
# Disabled pending separate review: can export private data to an external service.
REMOTE_SYNC_URL=
REMOTE_SYNC_TOKEN=
REMOTE_SYNC_METHOD=POST
REMOTE_SYNC_TIMEOUT=7000
